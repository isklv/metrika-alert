# Secrets for metrika-alert, loaded by systemd via EnvironmentFile.
# Install as /etc/metrika-alert/env with: chown root:root, chmod 600.
#
# Environment values override the matching keys in config.yaml.

# --- Telegram ---
METRIKA_BOT_TOKEN=7304642400:AAH...
METRIKA_ADMIN_IDS=123456789,987654321

# --- VK Teams ---
METRIKA_VKTEAMS_TOKEN=001.0123456789.0123456789:700000001
METRIKA_VKTEAMS_ADMINS=admin@corp.example,ops@corp.example
# On-premise only; omit for the VK Teams cloud.
#METRIKA_VKTEAMS_BASE=https://myteam.corp.example/bot/v1

# --- Yandex.Metrika ---
#METRIKA_METRIKA_BASE=https://api-metrika.yandex.net
#METRIKA_SETTLE_MINUTES=20
#METRIKA_MAX_CATCH_UP_HOURS=6

# --- REST API ---
#METRIKA_API_ENABLED=true
#METRIKA_API_TOKEN=generate-with-openssl-rand-hex-32
